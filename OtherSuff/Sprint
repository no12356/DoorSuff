-- language: Lua, target: Roblox, client-side

local Players              = game:GetService("Players")
local RunService           = game:GetService("RunService")
local TweenService         = game:GetService("TweenService")
local ContextActionService = game:GetService("ContextActionService")

local LP  = Players.LocalPlayer
local cam = workspace.CurrentCamera

-- ========== CONFIG ==========
local BIND_A          = Enum.KeyCode.LeftShift
local BIND_B          = Enum.KeyCode.RightShift
local FOV_SPRINT      = 90
local FOV_IDLE        = 70

local STAMINA_MAX     = 100
local DRAIN_PER_SEC   = 12.5       -- ~8.3 seconds of sprint at full tank
local REGEN_PER_SEC   = 8.3      -- ~12.5 seconds to refill from empty

local SPRINT_SPEED    = 20.5      -- flat walkspeed while sprinting
local HIDE_DELAY      = 10      -- seconds bar stays visible after sprint ends

-- ========== GUI ==========
local gui = Instance.new("ScreenGui")
gui.Name = "StaminaBar"
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.ResetOnSpawn = false
gui.Parent = LP:WaitForChild("PlayerGui")

local Border = Instance.new("Frame")
Border.Name = "Border"
Border.Parent = gui
Border.AnchorPoint = Vector2.new(0, 1)
Border.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
Border.BorderColor3 = Color3.fromRGB(0, 0, 0)
Border.BorderSizePixel = 4
Border.Position = UDim2.new(0.25, 0, 0.85, 0)
Border.Size = UDim2.new(0.6, 0, 0.026, 0)

local Bar = Instance.new("Frame")
Bar.Name = "Bar"
Bar.Parent = Border
Bar.AnchorPoint = Vector2.new(0, 1)
Bar.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
Bar.BorderSizePixel = 0
Bar.Position = UDim2.new(0, 0, 1, 0)
Bar.Size = UDim2.new(1, 0, 1, 0)

local SideBar = Instance.new("Frame")
SideBar.Name = "SideBar"
SideBar.Parent = gui
SideBar.AnchorPoint = Vector2.new(0, 1)
SideBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
SideBar.BorderColor3 = Color3.fromRGB(0, 0, 0)
SideBar.BorderSizePixel = 4
SideBar.Position = UDim2.new(0.986, 0, 1, 0)
SideBar.Size = UDim2.new(0.014, 0, 0.175, 0)

local SideBarBar = Instance.new("Frame")
SideBarBar.Name = "Bar"
SideBarBar.Parent = SideBar
SideBarBar.AnchorPoint = Vector2.new(0, 1)
SideBarBar.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
SideBarBar.BorderSizePixel = 0
SideBarBar.Position = UDim2.new(0, 0, 1, 0)
SideBarBar.Size = UDim2.new(1, 0, 1, 0)

-- ========== STATE ==========
local stamina         = STAMINA_MAX
local sprinting       = false
local sprintFOVActive = false
local sprintEndTime   = 0
local defaultSpeed    = 16
local humanoid

-- ========== HELPERS ==========
local FOV_INFO = TweenInfo.new(1, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local function setFOV(v)
	TweenService:Create(cam, FOV_INFO, { FieldOfView = v }):Play()
end

local function updateBar()
	local frac = math.clamp(stamina / STAMINA_MAX, 0, 1)
	Bar.Size        = UDim2.new(frac, 0, 1, 0)
	SideBarBar.Size = UDim2.new(1, 0, frac, 0)
end

local function updateVisibility()
	local active    = sprinting or (tick() - sprintEndTime < HIDE_DELAY)
	Border.Visible  = active
	SideBar.Visible = not active
end

-- ========== CHARACTER ==========
local function onCharacter(char)
	humanoid = char:WaitForChild("Humanoid")
	defaultSpeed = humanoid.WalkSpeed
	stamina = STAMINA_MAX
	sprinting = false
	sprintFOVActive = false
	updateBar()
	updateVisibility()
end

if LP.Character then onCharacter(LP.Character) end
LP.CharacterAdded:Connect(onCharacter)

-- ========== SPRINT ==========
local function sprint(_, state)
	if not humanoid then return end

	if state == Enum.UserInputState.Begin then
		if not sprinting then
			defaultSpeed = humanoid.WalkSpeed
		end
		sprinting = true
		humanoid.WalkSpeed = SPRINT_SPEED
		updateVisibility()

		local last = tick()
		while stamina > 0 and sprinting do
			task.wait()
			local now = tick()
			local dt  = now - last
			last = now

			if not sprintFOVActive then
				sprintFOVActive = true
				setFOV(FOV_SPRINT)
			end

			stamina = math.max(0, stamina - DRAIN_PER_SEC * dt)
			updateBar()
			updateVisibility()
		end

		if stamina <= 0 then
			sprinting     = false
			sprintEndTime = tick()
			if sprintFOVActive then
				sprintFOVActive = false
				setFOV(FOV_IDLE)
			end
			if humanoid then
				humanoid.WalkSpeed = defaultSpeed
			end
			updateVisibility()
		end

	elseif state == Enum.UserInputState.End then
		sprinting     = false
		sprintEndTime = tick()
		if humanoid then
			humanoid.WalkSpeed = defaultSpeed
		end
		updateVisibility()

		local last = tick()
		while stamina < STAMINA_MAX and not sprinting do
			task.wait()
			local now = tick()
			local dt  = now - last
			last = now

			stamina = math.min(STAMINA_MAX, stamina + REGEN_PER_SEC * dt)

			if sprintFOVActive then
				sprintFOVActive = false
				setFOV(FOV_IDLE)
			end
			updateBar()
			updateVisibility()
		end
	end
end

ContextActionService:BindAction("Sprint", sprint, true, BIND_A, BIND_B)
ContextActionService:SetPosition("Sprint", UDim2.new(0.7, 0, 0, 0))
ContextActionService:SetTitle("Sprint", "Shift")

-- ========== EXTERNAL WALKSPEED WATCHER ==========
task.spawn(function()
	while true do
		task.wait(0.25)
		if humanoid and humanoid.Parent then
			local ws = humanoid.WalkSpeed
			if not sprinting and ws ~= SPRINT_SPEED and ws ~= 10 then
				defaultSpeed = ws
			end
		end
	end
end)

-- ========== CAMERA BOBBLE ==========
RunService.RenderStepped:Connect(function()
	if not humanoid then return end
	if sprintFOVActive and humanoid.MoveDirection.Magnitude > 0 then
		local t = tick()
		local bobX = math.abs(math.sin(t * 10)) * 0.05
		local bobY = math.abs(math.sin(t * 10)) * 0.35
		humanoid.CameraOffset = humanoid.CameraOffset:Lerp(Vector3.new(bobX, bobY, 0), 0.75)
	else
		humanoid.CameraOffset = humanoid.CameraOffset:Lerp(Vector3.new(), 0.75)
	end
end)

-- ========== INIT ==========
updateBar()
updateVisibility()